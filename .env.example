# ══════════════════════════════════════════════════════════
#  FACTURAMI CLOUD — Configuración de Variables de Entorno
#  Copia este archivo como .env en tu servidor VPS:
#    cp .env.example .env
# ══════════════════════════════════════════════════════════

# ── Dominio & Seguridad Web (Caddy SSL) ───────────────────
# El dominio que apunta a la IP de tu VPS
DOMAIN_NAME=facturami.tudominio.com

# Subdominio para la consola de administración de n8n
N8N_DOMAIN=n8n.tudominio.com

# Tu correo electrónico para alertas y certificados de Let's Encrypt
ACME_EMAIL=admin@tudominio.com

# ── Claves Criptográficas ─────────────────────────────────
# Genera una clave aleatoria segura: openssl rand -hex 32
JWT_SECRET_KEY=cambiar-por-un-secreto-aleatorio-muy-largo-2026

# Token interno para comunicación cifrada entre Flask y n8n
N8N_INTERNAL_SECRET=token-secreto-interno-n8n-facturami-2026

# ── Inteligencia Artificial & Automatización ──────────────
# Tu clave de Google Gemini para lectura OCR de facturas
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Clave de API de n8n (opcional)
N8N_API_KEY=

# ── Red Interna (No cambiar a menos que sea necesario) ────
FLASK_PORT=5001
CORS_ORIGINS=*
FACTURAMI_STORAGE_PATH=/app/storage
FACTURAMI_TMP_PATH=/app/tmp
FACTURAMI_DB_PATH=/app/facturami.db
N8N_WEBHOOK_URL=http://n8n:5678/webhook/importar-facturas
N8N_BASE_URL=http://n8n:5678
