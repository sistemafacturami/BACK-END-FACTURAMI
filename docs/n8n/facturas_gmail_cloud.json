    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "=key",
              "value": "={{ $env.GEMINI_API_KEY || 'TU_GEMINI_API_KEY' }}"
