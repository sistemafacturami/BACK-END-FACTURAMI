        "jsonBody": "={\n  \"client_id\": \"504470991\",\n  \"origen\": \"gmail\",\n  \"FECHA\": \"{{ $json.JsonString[0].FECHAFACTURA }}\",\n  \"FACTURA\": \"{{ $json.JsonString[0].NUMEROFACTURA }}\",\n  \"Categoria\": \"{{ $json.JsonString[0].Categoria }}\",\n  \"PROVEEDOR\": \"{{ $json.JsonString[0].PROVEEDOR }}\",\n  \"SUB TOTAL\": \"{{ $json.JsonString[0]['SUB TOTAL'] }}\",\n  \"IVA 1%\": \"{{ $json.JsonString[0]['IVA 1%'] }}\",\n  \"IVA 2%\": \"{{ $json.JsonString[0]['IVA 2%'] }}\",\n  \"IVA 4%\": \"{{ $json.JsonString[0]['IVA otros'] }}\",\n  \"IVA 13%\": \"{{ $json.JsonString[0]['IVA 13%'] }}\",\n  \"TOTAL\": \"{{ $json.JsonString[0].TOTAL }}\",\n  \"Notas\": \"{{ $json.JsonString[0].Notas }}\",\n  \"DRIVE_ID\": \"{{ $('Download file1').item.json.id }}\"\n}",
        "options": {}
