{
    # Correo para registro y notificaciones de certificados SSL automaticos Let's Encrypt
    email {$ACME_EMAIL:soporte@facturami.app}
}

# ── Redireccion de acceso directo por IP al dominio canonico ───────────────
http://2.31.84.149, https://2.31.84.149 {
    tls internal
    redir https://{$DOMAIN_NAME:facturami.app}{uri} permanent
}

# ── Dominio Principal: FACTURAMI (Web App + Backend API con Let's Encrypt) ─
{$DOMAIN_NAME:facturami.app}, www.{$DOMAIN_NAME:facturami.app} {
    encode zstd gzip

    # Encabezados de seguridad
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "display-capture=(), camera=(), microphone=(), geolocation=()"
    }

    # Bloqueo de rutas internas desde el exterior (n8n llama a app:5001 por red interna Docker)
    @interno path /api/internal/*
    handle @interno {
        respond "Not found" 404
    }

    # Redireccion de webhooks de n8n si se usan desde el mismo dominio
    handle /webhook/* {
        reverse_proxy n8n:5678 {
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Todo el trafico principal hacia FACTURAMI
    handle {
        reverse_proxy app:5001 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# ── Subdominio opcional: Interfaz de Gestion n8n ─────────────────────
{$N8N_DOMAIN:n8n.facturami.app} {
    encode zstd gzip

    reverse_proxy n8n:5678 {
        flush_interval -1
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-Host {host}
    }
}
