              "value": "={{ Array.isArray(JSON.parse($json.candidates[0].content.parts[0].text)) ? JSON.parse($json.candidates[0].content.parts[0].text) : [JSON.parse($json.candidates[0].content.parts[0].text)] }}",
              "type": "array"
            }
          ]
        },
