        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"client_id\": \"{{ $('Recibir PDF').item.json.body.client_id || 'default' }}\",\n  \"hash_archivo\": \"{{ $('Recibir PDF').item.json.body.hash_archivo || '' }}\",\n  \"origen\": \"pdf_manual\",\n  \"FECHA\": \"{{ $json.JsonString[0].FECHAFACTURA }}\",\n  \"FACTURA\": \"{{ $json.JsonString[0].NUMEROFACTURA }}\",\n  \"Categoria\": \"{{ $json.JsonString[0].Categoria }}\",\n  \"PROVEEDOR\": \"{{ $json.JsonString[0].PROVEEDOR }}\",\n  \"SUB TOTAL\": \"{{ $json.JsonString[0]['SUB TOTAL'] }}\",\n  \"IVA 1%\": \"{{ $json.JsonString[0]['IVA 1%'] }}\",\n  \"IVA 2%\": \"{{ $json.JsonString[0]['IVA 2%'] }}\",\n  \"IVA 4%\": \"{{ $json.JsonString[0]['IVA otros'] }}\",\n  \"IVA 13%\": \"{{ $json.JsonString[0]['IVA 13%'] }}\",\n  \"TOTAL\": \"{{ $json.JsonString[0].TOTAL }}\",\n  \"Notas\": \"{{ $json.JsonString[0].Notas }}\",\n  \"DRIVE_ID\": \"{{ $('Descargar PDF1').item.json.id }}\"\n}"
      },
